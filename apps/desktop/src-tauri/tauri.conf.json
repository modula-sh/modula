{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modula",
  "version": "0.2.0",
  "identifier": "com.modula.gui",
  "build": {
    "beforeDevCommand": "pnpm dev --port 9100 --strictPort",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:9100",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 19.5 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "category": "DeveloperTool",
    "license": "Elastic-2.0",
    "shortDescription": "Modula Agentic Engineering Platform",
    "longDescription": "Modula Agentic Engineering Platform",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libayatana-appindicator-gtk3"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwQTc4NzRBMUQ5NjVDRTAKUldUZ1hKWWRTb2VuOE1yaUZUUHFKR3ZzM2ZVcUt1MlpQOCt0KzhxNXN3QVA3aWx4bHFmbXNaVE4K"
    }
  }
}
